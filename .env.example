# Canonical production origin. No trailing slash.
# Use http://localhost:3000 for local testing.
SITE_URL=http://localhost:3000

# Google Analytics 4 measurement ID (exposed to the client).
NEXT_PUBLIC_GA_ID=G-VWS9V4TY11

# --- Admin console (agenda editor) ---
# Generate the hash + a session secret with:
#   node scripts/hash-password.mjs '<your-strong-password>'
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Optional: directory for the agenda JSON file (defaults to ./data).
# AGENDA_DATA_DIR=/var/data/simbiochem

# --- Registration (optional). Fail closed until tested. ---
REGISTRATION_ENABLED=false

# --- Volunteer / Programme Committee sign-up ---
VOLUNTEER_ENABLED=true

# --- Public OpenReview data (server-side only) ---
OPENREVIEW_API_URL=https://api2.openreview.net
OPENREVIEW_VENUE_ID=NeurIPS.cc/2026/Workshop/Simbiochem
OPENREVIEW_SUBMISSION_INVITATION=NeurIPS.cc/2026/Workshop/Simbiochem/-/Submission

# --- Google Sheets sink (server-side only) ---
# Registrations and volunteers write to different tabs of the same spreadsheet.
GOOGLE_SHEETS_SPREADSHEET_ID=1pxCkRSf6BPh4D7zduboVPfbkvm9hiKIbBzZMIWny3S8
GOOGLE_SHEETS_RANGE=Registrations!A:J
GOOGLE_SHEETS_VOLUNTEERS_RANGE=Volunteers!A:I
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Alternatively, keep the downloaded service-account JSON in .secrets/.
# Do not commit that directory.
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS_FILE=
